# ValidureHR — deployment configuration template.
# Copy to .env and fill in real values.  NEVER commit or zip the real .env:
# it holds the mail password and the token signing key.

# --- Security (REQUIRED — the API refuses to start without these) ------------
# JWT_SECRET signs every session token. Anyone who knows it can mint an admin
# token for any company, so it must be random, secret, and at least 32 chars.
# Generate one with:
#   docker exec validurehr-backend node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Password for the built-in 'admin' account. Used on FIRST RUN ONLY, when the
# account is created; changing it later has no effect (change it in the portal,
# or run admin-reset.bat). Minimum 12 characters, and the old default
# 'Admin@123' is rejected.
ADMIN_PASSWORD=

# --- Machine-to-machine secrets (optional — each endpoint fails closed) ------
# Shared secret for the external scheduler hitting /api/cron/* (GitHub Actions
# sends it as x-cron-secret). Unset = those endpoints answer 503.
CRON_SECRET=

# Shared secret for the office Attendance Manager pushing biometric times to
# /api/integrations/attendance (sent as x-sync-secret). Unset = 503.
ATTENDANCE_SYNC_SECRET=

# --- Database ----------------------------------------------------------------
DB_PASSWORD=

# --- Email delivery (optional — without it mail is only logged in-app) -------
# Many hosts block outbound SMTP on 25, 465 and 587 to stop spam — Render does
# on free instances — and every mail then fails with a connection timeout. If
# that is your host, point these at a relay listening on a port it allows
# (Brevo and Mailgun both offer 2525) instead of at the mailbox provider
# directly. See docs/DEPLOYMENT_RENDER.md.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Leave blank unless the relay is unusual: 465 and 2465 mean implicit TLS, any
# other port starts in the clear and upgrades with STARTTLS.
SMTP_SECURE=
MAIL_FROM=ValidureHR <no-reply@example.com>

# --- Login throttling (optional — these are the defaults) --------------------
# Consecutive failures before an account locks itself, and for how long.
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# --- Proxy awareness (optional) ----------------------------------------------
# Number of reverse proxies in front of the API, for correct client IPs.
# 0 (default) trusts nothing. Only raise it if you actually run a proxy —
# trusting a hop that isn't there lets clients spoof their own IP.
TRUST_PROXY=0
# Set to true only for plain-HTTP LAN deployments with no TLS in front.
DISABLE_HSTS=false

# --- Public URLs (Serveo tunnels) --------------------------------------------
SERVEO_APP_SUBDOMAIN=
SERVEO_API_SUBDOMAIN=
SERVEO_KEY_APP=
SERVEO_KEY_API=
SERVEO_USER=

# Empty = single-tunnel mode (the app proxies /api to the backend internally).
PUBLIC_API_URL=

# Browser origins allowed to call the API. Empty = allow any (not recommended).
CORS_ORIGINS=http://localhost:3000

# --- Local ports / binding ---------------------------------------------------
BIND_ADDR=0.0.0.0
FRONTEND_PORT=3000
BACKEND_PORT=5050
